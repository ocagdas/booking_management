# Copy this file to docker-compose.override.yml to customise your local setup.
# docker-compose.override.yml is gitignored so your changes stay local.
#
# Docker Compose automatically merges docker-compose.override.yml on top of
# docker-compose.yml whenever you run docker compose up / exec / run.
#
# Common customisations:
#   - Change the host port the app listens on (default: 8000)
#   - Change the host port PostgreSQL is exposed on (default: 5432)
#   - Rename the Postgres data volume (useful when running multiple projects)

services:
  app:
    ports:
      - "8001:8000"   # expose the app on a different host port

  db:
    ports:
      - "5433:5432"   # expose Postgres on a different host port
    volumes:
      - my_project_postgres_data:/var/lib/postgresql/data

volumes:
  my_project_postgres_data:
    # rename the volume so it doesn't clash with other projects
